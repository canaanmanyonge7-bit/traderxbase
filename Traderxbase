        id="email"
        placeholder="Email address"
      >

      <input
        type="password"
        id="password"
        placeholder="Password"
      >

      <button onclick="signUp()">Create Account</button>

      <button class="secondary" onclick="signIn()">
        Login
      </button>

      <p id="message"></p>

    </div>

    <div id="dashboard">

