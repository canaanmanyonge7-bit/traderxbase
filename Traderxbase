      justify-content: center;
      align-items: center;
    }

    .container {
      width: 92%;
      max-width: 420px;
      background: #111b2e;
      padding: 28px;
      border-radius: 18px;
      box-shadow: 0 10px 40px rgba(0,0,0,.4);
    }

    h1 {
      text-align: center;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      color: #9ca9bd;
      margin-bottom: 25px;
    }

    input {
      width: 100%;
      padding: 14px;
      margin: 8px 0;
      border: 1px solid #34425b;
      border-radius: 10px;
      background: #0b1220;
      color: white;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      border: none;
      border-radius: 10px;
      background: #16a34a;
      color: white;
      font-size: 16px;
      font-weight: bold;
    }

    button.secondary {
      background: #26344d;
    }

    #message {
      text-align: center;
      margin-top: 15px;
      color: #facc15;
    }

    #dashboard {
      display: none;
      text-align: center;
    }

    .logout {
      background: #dc2626;
    }
  </style>
</head>

